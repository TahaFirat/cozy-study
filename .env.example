# Cozy Pixel Study Room — Environment Variables
#
# ──────────────────────────────────────────────────────────────────────────────
# PADDLE BILLING (Türkiye & Global Uyumlu Ödeme Sağlayıcısı)
# ──────────────────────────────────────────────────────────────────────────────
VITE_PADDLE_ENV=sandbox

# Paddle Catalog'da oluşturulan Price ID'leri:
VITE_PADDLE_PRICE_MONTHLY=pri_monthly_placeholder
VITE_PADDLE_PRICE_YEARLY=pri_yearly_placeholder
VITE_PADDLE_PRICE_LIFETIME=pri_lifetime_placeholder

# Developer Tools -> Authentication -> Client-side token (test_...)
VITE_PADDLE_CLIENT_TOKEN=

# Backend API Key:
PADDLE_API_KEY=pdl_sdbx_apikey_placeholder
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# FIREBASE (Frontend — Opsiyonel)
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
